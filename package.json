{
  "name": "autostream-docs",
  "private": true,
  "description": "AutoStream public user and operator documentation.",
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "docs:check-secrets": "node scripts/check-secrets.mjs",
    "docs:check-release-workflow": "node scripts/check-release-workflow.mjs",
    "docs:check-updater-contract": "node scripts/check-updater-contract.mjs",
    "docs:test-updater-contract": "node --test scripts/test-updater-contract.mjs",
    "docs:check-physical-eol": "node scripts/check-physical-eol.mjs",
    "docs:test-stream-create": "node --test scripts/test-stream-create-docs.mjs",
    "docs:check": "npm run docs:check-secrets && npm run docs:check-release-workflow && npm run docs:check-updater-contract && npm run docs:test-updater-contract && npm run docs:check-physical-eol && npm run docs:test-stream-create"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "vite": "6.4.3",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "esbuild": "0.25.12",
    "vite": "6.4.3"
  }
}
